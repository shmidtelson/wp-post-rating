{
    "name": "romua1d/wp-post-rating",
    "description": "WordPress Post Rating",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "romua1d",
            "email": "admin@romua1d.ru"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "WPR\\": "src/"
        }
    },
    "scripts": {
        "setup": [
            "yarn install --frozen-lockfile",
            "@build-assets"
        ],
        "install-dev": [
            "@setup"
        ],
        "build": "@build-assets",
        "build-assets": "yarn build",
        "copy-wp": "make copy-wp"
    }
}
